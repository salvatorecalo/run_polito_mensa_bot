{
    "name": "Run Polito Mensa Bot - Modern Stack",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "devcontainer",
    "workspaceFolder": "/workspaces/run_polito_mensa_bot",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance", 
                "ms-python.debugpy",
                "ms-python.black-formatter",
                "ms-python.isort",
                "ms-python.mypy-type-checker",
                "ms-azuretools.vscode-docker",
                "eamodio.gitlens",
                "ms-vscode.vscode-json",
                "redhat.vscode-yaml",
                "mtxr.sqltools",
                "mtxr.sqltools-driver-pg",
                "mtxr.sqltools-driver-sqlite",
                "bradlc.vscode-tailwindcss"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python",
                "python.analysis.typeCheckingMode": "basic",
                "python.analysis.autoImportCompletions": true,
                "python.analysis.inlayHints.variableTypes": true,
                "python.analysis.inlayHints.functionReturnTypes": true,
                "editor.formatOnSave": true,
                "editor.codeActionsOnSave": {
                    "source.organizeImports": "explicit"
                },
                "[python]": {
                    "editor.defaultFormatter": "ms-python.black-formatter",
                    "editor.formatOnSave": true,
                    "editor.codeActionsOnSave": {
                        "source.organizeImports.isort": "explicit"
                    }
                },
                "black-formatter.args": ["--line-length=100"],
                "isort.args": ["--profile=black"],
                "mypy-type-checker.args": ["--ignore-missing-imports"],
                "files.exclude": {
                    "**/__pycache__": true,
                    "**/*.pyc": true,
                    "**/.mypy_cache": true,
                    "**/alembic/versions/*.py": false
                }
            }
        }
    },
    "forwardPorts": [
        5432,
        6379
    ],
    "portsAttributes": {
        "5432": {
            "label": "PostgreSQL"
        },
        "6379": {
            "label": "Redis"
        }
    },
    "postCreateCommand": "bash .devcontainer/setup.sh",
    "remoteUser": "vscode",
    "mounts": [
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,readonly,type=bind,consistency=cached"
    ],
    "remoteEnv": {
        "IG_USERNAME": "${localEnv:IG_USERNAME}",
        "IG_PASSWORD": "${localEnv:IG_PASSWORD}",
        "TARGET_USER": "${localEnv:TARGET_USER}",
        "TELEGRAM_TOKEN": "${localEnv:TELEGRAM_TOKEN}",
        "TELEGRAM_CHAT_ID": "${localEnv:TELEGRAM_CHAT_ID}",
        "DATABASE_URL": "${localEnv:DATABASE_URL:-sqlite+aiosqlite:///./polito_mensa.db}",
        "REDIS_URL": "${localEnv:REDIS_URL:-redis://localhost:6379/0}",
        "DEBUG": "${localEnv:DEBUG:-true}"
    }
}
